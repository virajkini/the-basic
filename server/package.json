{
  "name": "file-upload-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/assets/branding && cp src/assets/branding/android-chrome-512x512.png dist/assets/branding/",
    "start": "node dist/index.js",
    "init:db": "tsx scripts/init-db-indexes.ts",
    "init:db:stage": "APP_ENV=stage tsx scripts/init-db-indexes.ts",
    "seed:stage": "APP_ENV=stage tsx scripts/seed-stage-data.ts",
    "test:insert-data": "tsx scripts/insert-sample-data.ts",
    "compute:base-score": "node lambda/compute-base-score/run-local.js",
    "migrate:photo-keys": "tsx scripts/migratePhotoKeys.ts",
    "migrate:photo-keys:stage": "APP_ENV=stage tsx scripts/migratePhotoKeys.ts",
    "migrate:photo-keys:dry": "DRY_RUN=1 tsx scripts/migratePhotoKeys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/cloudfront-signer": "^3.957.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
